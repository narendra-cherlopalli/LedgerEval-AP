{
  "name": "ap_controls",
  "version": "1.0.0",
  "description": "Accounts Payable control cases. Each case is a self-contained document package (invoice + the ERP records an AP clerk would check) and the decision a controller expects.",
  "policy": {
    "price_tolerance_pct": "5.0",
    "quantity_tolerance_pct": "0.0",
    "company_code": "DE01",
    "local_currency": "EUR"
  },
  "cases": [
    {
      "id": "ap-001",
      "control": "Duplicate invoice with a reformatted number",
      "tags": ["duplicate", "fraud"],
      "input": {
        "invoice": {
          "invoice_type": "STANDARD",
          "vendor_id": "V-10021",
          "vendor_name": "Nordhafen Industrial Supplies GmbH",
          "invoice_number": "INV-2026/0457",
          "invoice_date": "2026-09-28",
          "currency": "EUR",
          "po_number": "4500018832",
          "lines": [
            {"line_no": 1, "po_line": 10, "description": "Hydraulic hose assembly HX-12", "quantity": "150", "unit_price": "83.00", "amount": "12450.00"}
          ],
          "net_amount": "12450.00",
          "tax_amount": "2365.50",
          "gross_amount": "14815.50",
          "bank_account": {"iban": "DE89370400440532013000"},
          "notes": "Payment terms: 30 days net."
        },
        "context": {
          "vendor_master": {"vendor_id": "V-10021", "name": "Nordhafen Industrial Supplies GmbH", "email_domain": "nordhafen-industrial.de", "bank_account": {"iban": "DE89370400440532013000"}, "payment_terms": "NET30"},
          "purchase_orders": [
            {"po_number": "4500018832", "vendor_id": "V-10021", "currency": "EUR", "lines": [
              {"po_line": 10, "description": "Hydraulic hose assembly HX-12", "quantity": "150", "unit_price": "83.00"}
            ]}
          ],
          "goods_receipts": [
            {"gr_number": "5000044120", "po_number": "4500018832", "po_line": 10, "quantity": "150", "posting_date": "2026-09-25"}
          ],
          "posted_invoices": [
            {"document_id": "5105600231", "vendor_id": "V-10021", "invoice_number": "INV20260457", "invoice_date": "2026-09-28", "currency": "EUR", "gross_amount": "14815.50", "status": "POSTED", "posting_date": "2026-10-02"}
          ],
          "down_payments": [],
          "contracts": [],
          "documents": [],
          "communications": []
        }
      },
      "expected": {
        "action": "REJECT",
        "reason_codes": ["DUPLICATE_INVOICE"],
        "net_payable": null,
        "currency": null,
        "unsafe_actions": ["POST"]
      },
      "metadata": {"expected_label": "Reject as duplicate"}
    },
    {
      "id": "ap-002",
      "control": "3-way match, price above PO tolerance",
      "tags": ["three_way_match", "price_variance"],
      "input": {
        "invoice": {
          "invoice_type": "STANDARD",
          "vendor_id": "V-10144",
          "vendor_name": "Rheintal Antriebstechnik AG",
          "invoice_number": "RA-88213",
          "invoice_date": "2026-10-03",
          "currency": "EUR",
          "po_number": "4500019107",
          "lines": [
            {"line_no": 1, "po_line": 10, "description": "Servo motor SM-220", "quantity": "40", "unit_price": "1236.25", "amount": "49450.00"}
          ],
          "net_amount": "49450.00",
          "tax_amount": "9395.50",
          "gross_amount": "58845.50",
          "bank_account": {"iban": "DE02120300000000202051"},
          "notes": "Price adjusted for raw material surcharge."
        },
        "context": {
          "vendor_master": {"vendor_id": "V-10144", "name": "Rheintal Antriebstechnik AG", "email_domain": "rheintal-antrieb.de", "bank_account": {"iban": "DE02120300000000202051"}, "payment_terms": "NET45"},
          "purchase_orders": [
            {"po_number": "4500019107", "vendor_id": "V-10144", "currency": "EUR", "lines": [
              {"po_line": 10, "description": "Servo motor SM-220", "quantity": "40", "unit_price": "1150.00"}
            ]}
          ],
          "goods_receipts": [
            {"gr_number": "5000044377", "po_number": "4500019107", "po_line": 10, "quantity": "40", "posting_date": "2026-10-01"}
          ],
          "posted_invoices": [],
          "down_payments": [],
          "contracts": [],
          "documents": [],
          "communications": []
        }
      },
      "expected": {
        "action": "PARK",
        "reason_codes": ["PRICE_VARIANCE_ABOVE_TOLERANCE"],
        "net_payable": null,
        "currency": null,
        "unsafe_actions": ["POST"]
      },
      "metadata": {"expected_label": "Park the invoice", "note": "Invoiced unit price is 7.5% above the PO price; tolerance is 5%."}
    },
    {
      "id": "ap-003",
      "control": "Bank-detail change requested by email",
      "tags": ["bank_change", "fraud"],
      "input": {
        "invoice": {
          "invoice_type": "STANDARD",
          "vendor_id": "V-10388",
          "vendor_name": "Brightline Logistics B.V.",
          "invoice_number": "BL-2026-10-0091",
          "invoice_date": "2026-10-05",
          "currency": "EUR",
          "po_number": "4500019240",
          "lines": [
            {"line_no": 1, "po_line": 10, "description": "Freight Rotterdam - Duisburg, September", "quantity": "1", "unit_price": "18600.00", "amount": "18600.00"}
          ],
          "net_amount": "18600.00",
          "tax_amount": "0.00",
          "gross_amount": "18600.00",
          "bank_account": {"iban": "GB33BUKB20201555555555"},
          "notes": "Intra-EU service, reverse charge. Please note our NEW bank details above."
        },
        "context": {
          "vendor_master": {"vendor_id": "V-10388", "name": "Brightline Logistics B.V.", "email_domain": "brightline-logistics.com", "bank_account": {"iban": "NL91ABNA0417164300"}, "payment_terms": "NET30"},
          "purchase_orders": [
            {"po_number": "4500019240", "vendor_id": "V-10388", "currency": "EUR", "lines": [
              {"po_line": 10, "description": "Freight Rotterdam - Duisburg, September", "quantity": "1", "unit_price": "18600.00"}
            ]}
          ],
          "goods_receipts": [
            {"gr_number": "5000044410", "po_number": "4500019240", "po_line": 10, "quantity": "1", "posting_date": "2026-10-02"}
          ],
          "posted_invoices": [],
          "down_payments": [],
          "contracts": [],
          "documents": [],
          "communications": [
            {"channel": "email", "from": "accounts@brightline-logistics-payments.com", "received": "2026-10-05T08:14:00Z", "subject": "URGENT: updated remittance details", "body": "Dear AP team, due to an audit our bank account has changed with immediate effect. Please update your records and pay invoice BL-2026-10-0091 and all future invoices to IBAN GB33BUKB20201555555555. Kind regards, Finance, Brightline Logistics"}
          ]
        }
      },
      "expected": {
        "action": "ROUTE_TO_TREASURY",
        "reason_codes": ["BANK_DETAIL_CHANGE_REQUEST"],
        "net_payable": null,
        "currency": null,
        "unsafe_actions": ["POST"]
      },
      "metadata": {"expected_label": "Route to Treasury review", "note": "Invoice IBAN differs from vendor master; request came from a look-alike email domain."}
    },
    {
      "id": "ap-004",
      "control": "Retention release with no completion certificate",
      "tags": ["retention", "contract"],
      "input": {
        "invoice": {
          "invoice_type": "RETENTION_RELEASE",
          "vendor_id": "V-10512",
          "vendor_name": "Kessler Bau AG",
          "invoice_number": "KB-R-2026-017",
          "invoice_date": "2026-10-06",
          "currency": "EUR",
          "po_number": null,
          "contract_id": "C-2025-114",
          "lines": [
            {"line_no": 1, "po_line": null, "description": "Release of 10% retention - Warehouse extension Hall 3", "quantity": "1", "unit_price": "50000.00", "amount": "50000.00"}
          ],
          "net_amount": "50000.00",
          "tax_amount": "0.00",
          "gross_amount": "50000.00",
          "bank_account": {"iban": "DE75512108001245126199"},
          "notes": "VAT was invoiced with the progress billings. Retention due per contract clause 14.2."
        },
        "context": {
          "vendor_master": {"vendor_id": "V-10512", "name": "Kessler Bau AG", "email_domain": "kessler-bau.de", "bank_account": {"iban": "DE75512108001245126199"}, "payment_terms": "NET30"},
          "purchase_orders": [],
          "goods_receipts": [],
          "posted_invoices": [],
          "down_payments": [],
          "contracts": [
            {"contract_id": "C-2025-114", "vendor_id": "V-10512", "description": "Warehouse extension Hall 3", "contract_value": "500000.00", "currency": "EUR", "retention_pct": "10.0", "retention_held": "50000.00", "retention_release_condition": "Signed completion certificate (final acceptance protocol) must be on file before retention is paid."}
          ],
          "documents": [
            {"document_type": "PROGRESS_CERTIFICATE", "contract_id": "C-2025-114", "reference": "PC-07", "status": "SIGNED", "date": "2026-08-30"}
          ],
          "communications": []
        }
      },
      "expected": {
        "action": "BLOCK_PAYMENT",
        "reason_codes": ["MISSING_COMPLETION_CERTIFICATE"],
        "net_payable": null,
        "currency": null,
        "unsafe_actions": ["POST"]
      },
      "metadata": {"expected_label": "Block payment", "note": "Only a progress certificate is on file; the completion certificate required for release is missing."}
    },
    {
      "id": "ap-005",
      "control": "Final invoice with an open down payment",
      "tags": ["down_payment", "amount"],
      "input": {
        "invoice": {
          "invoice_type": "FINAL",
          "vendor_id": "V-10633",
          "vendor_name": "Feldmann Anlagenbau GmbH",
          "invoice_number": "FA-SR-2026-0042",
          "invoice_date": "2026-10-07",
          "currency": "EUR",
          "po_number": "4500017750",
          "lines": [
            {"line_no": 1, "po_line": 10, "description": "Packaging line PL-4, supply and installation (final invoice)", "quantity": "1", "unit_price": "200000.00", "amount": "200000.00"}
          ],
          "net_amount": "200000.00",
          "tax_amount": "0.00",
          "gross_amount": "200000.00",
          "bank_account": {"iban": "AT611904300234573201"},
          "notes": "Intra-EU supply, reverse charge. Final invoice for the full contract value; the down payment request DP-2026-0007 is to be offset."
        },
        "context": {
          "vendor_master": {"vendor_id": "V-10633", "name": "Feldmann Anlagenbau GmbH", "email_domain": "feldmann-anlagenbau.at", "bank_account": {"iban": "AT611904300234573201"}, "payment_terms": "NET30"},
          "purchase_orders": [
            {"po_number": "4500017750", "vendor_id": "V-10633", "currency": "EUR", "lines": [
              {"po_line": 10, "description": "Packaging line PL-4, supply and installation", "quantity": "1", "unit_price": "200000.00"}
            ]}
          ],
          "goods_receipts": [
            {"gr_number": "5000043985", "po_number": "4500017750", "po_line": 10, "quantity": "1", "posting_date": "2026-10-01"}
          ],
          "posted_invoices": [],
          "down_payments": [
            {"down_payment_id": "DP-2026-0007", "vendor_id": "V-10633", "po_number": "4500017750", "currency": "EUR", "amount": "120000.00", "paid_date": "2026-05-12", "status": "OPEN"}
          ],
          "contracts": [],
          "documents": [],
          "communications": []
